@startuml ci_workflow
!theme plain
top to bottom direction
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8

skinparam rectangle {
  BorderColor #90A4AE
}

skinparam card {
  BorderColor #78909C
  BackgroundColor #FFFFFF
}

title Django - CI/CT Workflow

rectangle "Trigger" as trigger #E3F2FD {
  card "**Push / Pull Request**\n<color:#607D8B><i><size:10>Code arrives at GitHub</size></i></color>" as push #BBDEFB
  card "**Cron (Nightly)**\n<color:#607D8B><i><size:10>Daily at 02:42 UTC</size></i></color>" as cron #BBDEFB
}

rectangle "Always (every PR) - Fast Feedback, Low Cost" as always #D6E4F0 {
  card "**tests.yml**\n<color:#607D8B><i><size:10>Windows, JS, Scripts</size></i></color>" as tests #E8EFF5
  card "**linters.yml**\n<color:#607D8B><i><size:10>flake8, black, isort,\nbiome, zizmor</size></i></color>" as linters #E8EFF5
  card "**docs.yml**\n<color:#607D8B><i><size:10>Sphinx + Spelling</size></i></color>" as docs #E8EFF5
  card "**check-migrations**\n<color:#607D8B><i><size:10>DB integrity</size></i></color>" as migrations #E8EFF5
  card "**commit-messages**\n<color:#607D8B><i><size:10>Conventions</size></i></color>" as commits #E8EFF5
}

rectangle "On-Demand (per Label) - Deep Checks, Medium-High Cost" as ondemand #C5D5E4 {
  card "**python_matrix.yml**\n<color:#607D8B><i><size:10>All Python versions</size></i></color>" as matrix #DCE8F1
  card "**selenium.yml**\n<color:#607D8B><i><size:10>Browser tests</size></i></color>" as selenium #DCE8F1
  card "**screenshots.yml**\n<color:#607D8B><i><size:10>Visual regression</size></i></color>" as screenshots #DCE8F1
  card "**coverage**\n<color:#607D8B><i><size:10>Diff coverage + PR comment</size></i></color>" as coverage #DCE8F1
  card "**benchmark.yml**\n<color:#607D8B><i><size:10>Performance</size></i></color>" as benchmark #DCE8F1
  card "**postgis.yml**\n<color:#607D8B><i><size:10>GeoDjango</size></i></color>" as postgis #DCE8F1
}

rectangle "Nightly (Cron) - Full Matrix, High Cost" as nightly #B3C7D6 {
  card "**schedules.yml**\n<color:#607D8B><i><size:10>Check for new commits</size></i></color>" as schedules #D0DEE8
  card "**schedule_tests.yml**\n<color:#607D8B><i><size:10>All OS, Python, DBs,\nSelenium, pyc-only</size></i></color>" as schedule_tests #D0DEE8

  schedules -right-> schedule_tests : "  triggers  "
}

rectangle "Community - Process Automation" as community #A2B9C9 {
  card "**new_contributor_pr**\n<color:#607D8B><i><size:10>Welcome message</size></i></color>" as newcontrib #C4D4DF
  card "**labels.yml**\n<color:#607D8B><i><size:10>Auto-labeling</size></i></color>" as labels #C4D4DF
  card "**check_pr_quality**\n<color:#607D8B><i><size:10>PR quality check</size></i></color>" as prquality #C4D4DF
}

rectangle "Result" as result #93A9B9 {
  card "**All checks passed?**" as decision #B3C5D3
  card "**PR mergeable**" as ok #B3C5D3
  card "**Checks failed**\n<color:#607D8B><i><size:10>Developer fixes issues</size></i></color>" as fail #B3C5D3

  decision -down-> ok : "  Yes  "
  decision -right-> fail : "  No  "
}

push -down-> always : "  auto  "
push -down-> community : "  PR events  "
always -down-> ondemand : "  + Label  "
cron -down-> nightly
always -down-> decision
ondemand -down-> decision
nightly -down-> decision
fail -up-> push : "  fix & retry  "

@enduml
